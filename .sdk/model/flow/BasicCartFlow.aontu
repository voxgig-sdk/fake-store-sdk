# BasicCartFlow

main: kit: flow: BasicCartFlow:
{
  entity: "cart",
  kind: "basic",
  name: "BasicCartFlow",
  step: [
    {
      i: {
        ref: "cart_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "cart_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "cart_ref01",
        srcdatavar: "cart_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cart_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "cart_ref01",
        srcdatavar: "cart_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "cart01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cart_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "cart_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "cart01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "cart_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCartFlow"
}